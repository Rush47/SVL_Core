[Unit]
Description=SVL CoreOS 2: Apex (brama SVL + jądro Python + interfejs)
After=network-online.target svl-coreos2-firstboot.service ollama.service
Wants=network-online.target
Requires=svl-coreos2-firstboot.service

[Service]
Type=simple
WorkingDirectory=/opt/svl-coreos-2
EnvironmentFile=/etc/svl-coreos2/svl.env
Environment=NODE_ENV=production
Environment=PATH=/opt/svl-coreos-2/.venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/npx tsx server.ts
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
