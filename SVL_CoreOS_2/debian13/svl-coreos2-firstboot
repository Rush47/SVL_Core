#!/usr/bin/env bash
# SVL CoreOS 2: Apex — tworzy /etc/svl-coreos2/svl.env z nowym SVL_OPERATOR_TOKEN (tylko raz).
set -euo pipefail
ENV_DIR=/etc/svl-coreos2
ENV_FILE="${ENV_DIR}/svl.env"
STATE_DIR=/var/lib/svl-coreos2
[ -f "${ENV_FILE}" ] && exit 0
mkdir -p "${ENV_DIR}" "${STATE_DIR}"
umask 077
TOKEN="$(python3 -c 'import secrets; print(secrets.token_urlsafe(48))')"
cat > "${ENV_FILE}" <<CONF
# SVL CoreOS 2: Apex — konfiguracja (tylko root). Uzupełnij klucze i: systemctl restart svl-coreos2
SVL_OPERATOR_TOKEN=${TOKEN}
SVL_BIND_HOST=0.0.0.0
PORT=3000
SVL_SQLITE_PATH=${STATE_DIR}/svl_os.sqlite3
SVL_LOG_DIR=/opt/svl-coreos-2/logi
SVL_COREOS_EDITION=Apex
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_PREFERRED_MODEL=svl364-apex-uncensored:latest
GITHUB_TOKEN=
GEMINI_API_KEY=
CONF
echo "SVL CoreOS 2: utworzono ${ENV_FILE} (token: sudo grep SVL_OPERATOR_TOKEN ${ENV_FILE})"
