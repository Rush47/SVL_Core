# ============================================================================
# SVL PYTHON OS — DEBIAN 13 TRIXIE ENVIRONMENT CONFIGURATION
# ============================================================================

# SVL_OPERATOR_TOKEN: Minimum 32-character cryptographic secret for backend RBAC
# Used to authorize protected variable updates, Polkit/sudo terminal actions, and kernel mutations.
# When unset in development, the Python Kernel generates an ephemeral >=48-char session token at boot.
SVL_OPERATOR_TOKEN=""

# Token operatora domyślnie NIE jest wymagany (panel, API, /ws/svl i MCP działają bez niego).
# Ustaw 1, aby znów go wymagać — zalecane, gdy brama jest dostępna z internetu.
SVL_REQUIRE_OPERATOR_TOKEN="0"

# OpenSSH Host alias configured for the manual SSH terminal (for example, in ~/.ssh/config)
SVL_SSH_TARGET="Ship"
# Ollama ze statku SVL-364 jako standardowy silnik przez tunel SSH (local port-forward).
# 1 = gateway zestawia tunel ssh do aliasu SVL_SSH_TARGET i ustawia OLLAMA_HOST na jego koniec.
SVL_SHIP_OLLAMA="0"
# Port Ollamy na statku (zdalny) i port lokalny tunelu (OLLAMA_HOST będzie go używać).
SVL_SHIP_OLLAMA_PORT="11434"
SVL_SHIP_OLLAMA_LOCAL_PORT="11434"
# Model czatu Ollamy jest niżej: jedna linia OLLAMA_PREFERRED_MODEL (domyślnie llama3.2:1b).
# Codespaces/AI Studio wyłączają HMR automatycznie, aby proxy nie przeładowywało podglądu.
# W innym środowisku z podobnym ograniczeniem ustaw DISABLE_HMR=true.
# DISABLE_HMR="true"
# Modele uncensored pobierane na statek (po przecinku). Puste = domyślny zestaw GPU:
# dolphin-mixtral:8x22b, dolphin-llama3:70b, wizard-vicuna-uncensored:30b, dolphin-mixtral:8x7b.
SVL_SHIP_OLLAMA_MODELS=""
# Wydajność GPU na statku (dużo VRAM): 999 = wszystkie warstwy na GPU.
OLLAMA_NUM_GPU="999"
# Monitor jednostki SVL-364 przez SSH (powiadomienia Mayi na kanale „wszyscy”); 0 = wyłączony
SVL_SHIP_MONITOR_INTERVAL_SEC="120"

# GEMINI_API_KEY: opcjonalny zapasowy silnik Bielika i Mayi, gdy Ollama nie odpowiada
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# Klucz jest używany wyłącznie przez Node po stronie serwera. Nie używaj prefiksu VITE_
# i nie kopiuj sekretu do frontendowego kodu — AI Studio zarządza nim jako sekretem.
# Opcjonalnie: wymuszony model Gemini. Domyślnie serwer sam pobiera listę modeli dostępnych
# dla klucza (models.list) i pomija modele wycofane (404).
GEMINI_MODEL=""
# Limit pojedynczej próby i łączny budżet czasu odpowiedzi (ms)
GEMINI_TIMEOUT_MS="60000"
GEMINI_TOTAL_BUDGET_MS="150000"
# Ograniczenie „myślenia” modeli Gemini 3.x: MINIMAL | LOW | MEDIUM | HIGH | OFF
GEMINI_THINKING_LEVEL="LOW"

# XAI_API_KEY: płatny, główny silnik czatu (Grok przez API xAI). Klucz tylko po stronie serwera —
# nie używaj prefiksu VITE_ i nie umieszczaj go w kodzie frontendu.
# Gdy klucz jest pusty albo API xAI zawiedzie, system wraca do darmowej lokalnej Ollamy
# (oraz opcjonalnie Gemini, jeśli GEMINI_API_KEY jest ustawiony).
XAI_API_KEY=
# Model xAI (domyślnie grok-4.7)
XAI_MODEL="grok-4.7"
# Limit czasu pojedynczej próby odpowiedzi Grok (ms). Puste = 60000.
XAI_TIMEOUT_MS=
# Silnik czatu: auto (domyślnie: Grok, gdy jest klucz, potem Ollama) | ollama | grok
# ollama = nie wołaj API xAI w ogóle (także gdy XAI_API_KEY jest ustawiony).
# auto i grok: HTTP 401, 402 i 403 z xAI (zły klucz albo brak kredytów) wracają do Ollamy.
SVL_CHAT_ENGINE="auto"

# 0.0.0.0 jest wymagane przez podgląd full-stack AI Studio i Cloud Run.
SVL_BIND_HOST="0.0.0.0"

# OLLAMA_HOST: Local or networked Ollama engine endpoint (built-in daemon listens on 127.0.0.1:11434)
OLLAMA_HOST="http://127.0.0.1:11434"
# Jedyny model czatu Ollamy. Musi być pobrany (`ollama pull llama3.2:1b`).
OLLAMA_PREFERRED_MODEL="llama3.2:1b"
# Główny model multimodalny Llama 3.2 Vision (11B lub 90B) oraz jego parametry (ctx=4096, predict=1024, temp=0.2)
OLLAMA_VISION_MODEL="llama3.2-vision:11b"
OLLAMA_VISION_NUM_CTX="4096"
OLLAMA_VISION_NUM_PREDICT="1024"
OLLAMA_VISION_TEMPERATURE="0.2"
# Limit czasu odpowiedzi modelu w czacie (ms). Zimny start modelu 11B na CPU trwa długo.
OLLAMA_CHAT_TIMEOUT_MS="75000"
# Wydajność Ollamy (wartości dla wywołań z SVL):
# OLLAMA_KEEP_ALIVE: -1 = model zostaje w pamięci na stałe (domyślnie), np. "30m" = zwolnij po 30 min.
OLLAMA_KEEP_ALIVE="-1"
# Kontekst i długość odpowiedzi: mniejsze = szybciej (domyślnie 2048 / 512).
OLLAMA_NUM_CTX="2048"
OLLAMA_NUM_PREDICT="512"
# Puste = Ollama sama dobiera (zwykle najszybciej). Wymuszenie: wątki CPU, warstwy na GPU (999 = wszystkie), wsad.
OLLAMA_NUM_THREAD=""
OLLAMA_NUM_GPU=""
OLLAMA_NUM_BATCH=""
# 1 = zablokuj model w RAM (bez wymiany na dysk; wymaga wolnej pamięci).
OLLAMA_USE_MLOCK=""
# Ładowanie modeli Bielika i Mayi do pamięci przy starcie (0 = wyłącz); dodatkowe modele po przecinku.
OLLAMA_WARMUP="1"
OLLAMA_WARM_MODELS="llama3.2-vision:11b"
SVL_AI_MODEL_DIR="/opt/svl-ai-models"
COMFYUI_MODELS_PATH="/opt/svl-comfyui/models"
COMFYUI_HOST="http://127.0.0.1:8188"
# Keep ComfyUI as the default. Set to stable-diffusion.cpp after running
# deploy/install-sd-turbo-cpu.sh; generation requires at least 4 GiB free RAM.
SVL_IMAGE_ENGINE="comfyui"
SVL_SD_CPP_BINARY="./data/tools/stable-diffusion.cpp/build/bin/sd-cli"
SVL_SD_CPP_MODEL="./data/models/sd_turbo_q4_0.gguf"

# ============================================================================
# GITHUB — repozytorium Rush47/SVL_Core (jedyne obsługiwane)
# ============================================================================
# Klasyczny token GitHub (Settings → Developer settings → Personal access tokens →
# Tokens (classic)). Zakresy: repo, workflow; dla pełnej administracji dodatkowo
# admin:repo_hook i delete_repo. Token zostaje na serwerze — nie trafia do przeglądarki.
GITHUB_TOKEN=""
# Gałąź synchronizacji obustronnej katalogu projektu z GitHubem
SVL_GITHUB_SYNC_BRANCH="main"
# Automatyczna synchronizacja obustronna co N sekund (0 = wyłączona, minimum 60)
SVL_GITHUB_AUTOSYNC_SEC="0"
# Automatyczne POBIERANIE z GitHuba co N sekund — tylko fast-forward, nic nie commituje ani nie wysyła.
# Pomija pobranie, gdy masz lokalne commity albo niezapisane zmiany w plikach, które przychodzą z GitHuba.
# Puste = 60 s w trybie produkcyjnym (npm start) z katalogiem .git, wyłączone w AI Studio; 0 = wyłączone; minimum 15.
SVL_GITHUB_AUTOPULL_SEC=""

# ============================================================================
# SYNCHRONIZACJA NA ŻYWO — zmiany w repozytorium widoczne od razu w GUI
# ============================================================================
# Obserwator plików + HEAD gita: git pull (panel, terminal, auto-pull), zapisy czatu, MCP i agentów
# trafiają od razu do otwartych okien. 0 = wyłączone.
SVL_LIVE_REPO_SYNC="1"
# Grupowanie zmian: cisza przed wysłaniem (ms) i maksymalne opóźnienie przy ciągłych zmianach (ms)
SVL_LIVE_WATCH_DEBOUNCE_MS="300"
SVL_LIVE_WATCH_MAX_WAIT_MS="2000"
# Dodatkowe pomijane katalogi/ścieżki (po przecinku); node_modules, .git, dist, data, logi są pomijane zawsze
SVL_LIVE_WATCH_IGNORE=""
# Jak często sprawdzać HEAD gita (ms) — wykrywa git pull/commit/checkout także spoza aplikacji
SVL_LIVE_GIT_HEAD_POLL_MS="1500"
# Produkcja (npm start): automatyczna przebudowa GUI (vite build) po zmianie src/ lub index.html.
# Stary dist zostaje, jeśli build się nie uda.
SVL_LIVE_FRONTEND_REBUILD="1"
SVL_LIVE_REBUILD_DEBOUNCE_MS="800"
# Co robią otwarte karty po nowej wersji GUI: auto (przeładowanie; czeka, gdy piszesz) | prompt (przycisk) | off
# Puste = auto (w AI Studio: prompt)
SVL_LIVE_CLIENT_RELOAD=""
# Zmiana backend/*.py → restart jądra Python (gateway i GUI działają dalej)
SVL_LIVE_PYTHON_RESTART="1"
# Zmiana server.ts / src/server: auto (restart sam tylko pod systemd/pm2, inaczej przycisk w GUI) | always | off
SVL_LIVE_SERVER_RESTART="auto"
SVL_LIVE_RESTART_DELAY_MS="4000"
# Ustaw 1, jeśli gateway działa pod nadzorcą, którego nie wykrywamy sami (systemd i pm2 są wykrywane)
SVL_SUPERVISED=""
# Zmiana package.json po pull → npm install w tle (domyślnie nie; wtedy GUI prosi o restart, który zrobi npm install)
SVL_LIVE_AUTO_NPM_INSTALL="0"

# Autor commitów tworzonych przez synchronizację
SVL_GIT_AUTHOR_NAME="SVL Python OS"
SVL_GIT_AUTHOR_EMAIL="svl-core@users.noreply.github.com"
# Pliki edytowane przez narzędzie AI github_update_file trafiają na tę gałąź (nie na main)
SVL_GITHUB_FILE_BRANCH="svl-sync"
# Ollama agent workers connect to the loopback-only Streamable HTTP MCP endpoint.
SVL_GITHUB_MCP_URL="http://127.0.0.1:3000/mcp/github"

# Klucz MCP w adresie /mcp/svl/<klucz> dla konektora w aplikacji Claude (min. 32 znaki).
# Puste = serwer wygeneruje go sam i zapisze w data/svl_mcp_url_key.secret (adres w panelu Linux → Claude MCP).
SVL_MCP_URL_KEY=""

# ── Serwer MCP pełny odczyt/zapis (npm run mcp, usługa svl-mcp) — opis: deploy/MCP.md ──
# Token Bearer (min. 32 znaki). Puste = wygeneruje się sam i trafi do data/svl_mcp_token.secret (0600).
MCP_TOKEN=""
MCP_PORT="3334"
MCP_HOST="127.0.0.1"
# Katalog, w którym działają narzędzia plikowe (domyślnie katalog aplikacji).
MCP_ROOT=""
# 1 = tylko odczyt (ukrywa i blokuje zapis, usuwanie, powłokę i svl_chat)
MCP_READ_ONLY="0"
# 0 = wyłącza run_command (powłoka może wyjść poza MCP_ROOT — ma prawa użytkownika usługi)
MCP_ALLOW_SHELL="1"
# 0 = wyłącza token w adresie /mcp/k/<token> (dla klientów bez nagłówków); nagłówek Bearer działa zawsze
MCP_ALLOW_URL_TOKEN="1"
MCP_SHELL_TIMEOUT_MS="120000"
# Tunel do internetu bez stałego IP: cloudflared (domyślnie, bez konta) | ngrok | tailscale | none
MCP_TUNNEL="cloudflared"
# Stały adres: token nazwanego tunelu Cloudflare albo domena ngrok / Tailscale Funnel (opcjonalnie)
MCP_CLOUDFLARED_TOKEN=""
MCP_PUBLIC_URL=""

# DATABASE & PERSISTENCE (relative paths resolve from the repository root)
SVL_SQLITE_PATH="./data/svl_os.sqlite3"
SVL_PYTHON_PORT="8085"

