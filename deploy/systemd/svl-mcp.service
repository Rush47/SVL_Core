# SVL Universal MCP Hub (system + host SVL-364) z połączeniem internetowym bez stałego IP (jak Hamachi).
# Obsługuje: auto (Cloudflare Tunnel / Tailscale Funnel / ngrok / ssh-reverse) + wykrywanie sieci mesh.
# Instalacja: sudo bash deploy/install-mcp.sh   albo na SVL-364: sudo bash SVL_CoreOS_2/debian13/install_svl364_mcp_zeroip.sh
[Unit]
Description=SVL Universal MCP Hub (all services + zero-IP outbound tunnel)
After=network-online.target svl-coreos2.service svl-python-os.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=svlos
Group=svlos
WorkingDirectory=/opt/svl-python-os
EnvironmentFile=-/etc/svl-os/svl.env
EnvironmentFile=-/etc/svl-coreos2/svl.env
EnvironmentFile=-/opt/svl-python-os/.env
Environment=NODE_ENV=production
Environment=MCP_ROOT=/opt/svl-python-os
Environment=MCP_TUNNEL=auto
Environment=MCP_PORT=3334
Environment=SVL_BASE_URL=http://127.0.0.1:3000
Environment=SVL_LOG_DIR=/var/log/svl-os
ExecStart=/usr/bin/env npx --no-install tsx src/mcp/main.ts
Restart=always
RestartSec=5s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
