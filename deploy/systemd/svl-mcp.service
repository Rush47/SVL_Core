# SVL MCP (pełny odczyt/zapis) + automatyczny tunel do internetu (domyślnie Cloudflare Quick Tunnel).
# Instalacja: sudo bash deploy/install-mcp.sh   (albo ręcznie: kopiuj do /etc/systemd/system i `systemctl enable --now svl-mcp`)
[Unit]
Description=SVL MCP server (full read/write) with outbound tunnel
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=svlos
Group=svlos
WorkingDirectory=/opt/svl-python-os
EnvironmentFile=-/etc/svl-os/svl.env
EnvironmentFile=-/opt/svl-python-os/.env
Environment=NODE_ENV=production
Environment=MCP_ROOT=/opt/svl-python-os
Environment=SVL_LOG_DIR=/var/log/svl-os
ExecStart=/usr/bin/env npx --no-install tsx src/mcp/main.ts
Restart=always
RestartSec=5s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
